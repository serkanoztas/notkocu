NODE_ENV=development
PORT=4000
# 0.0.0.0 so a physical phone on the same Wi-Fi can reach the API via the PC's LAN IP
HOST=0.0.0.0
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/notkocu?retryWrites=true&w=majority

# openssl rand -base64 48 (min 32 chars)
JWT_ACCESS_SECRET=
# OAuth "Web application" client ID; must equal EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID in apps/mobile
GOOGLE_WEB_CLIENT_ID=

GEMINI_API_KEY=
# See https://ai.google.dev/gemini-api/docs/models for current IDs (needs image + PDF input and structured output)
# Default model for all jobs (course suggestion, document summary, and the fallback for the two below)
GEMINI_MODEL=gemini-3.1-flash-lite
# Image OCR and scanned PDFs (empty = GEMINI_MODEL)
# GEMINI_MODEL_OCR=
# Schedule (ders programı) parsing (empty = GEMINI_MODEL)
# GEMINI_MODEL_SCHEDULE=
# Lecture recording transcription (empty = GEMINI_MODEL)
# GEMINI_MODEL_AUDIO=
# Backup model: a call that gets 500/503 is retried once, at once, with this model (empty = no fallback)
# GEMINI_FALLBACK_MODEL=
# MINIMAL (default) or LOW; MINIMAL is skipped for models that do not support it (e.g. gemini-3.8-flash)
# GEMINI_THINKING_LEVEL=MINIMAL

# Per-user file storage cap in GridFS (MB)
# USER_STORAGE_LIMIT_MB=200

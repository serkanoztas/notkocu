NODE_ENV=development
PORT=4000
# 0.0.0.0 so a physical phone on the same Wi-Fi can reach the API via the PC's LAN IP
HOST=0.0.0.0
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/notkocu?retryWrites=true&w=majority

# openssl rand -base64 48 (min 32 chars)
JWT_ACCESS_SECRET=
# OAuth "Web application" client ID; must equal EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID in apps/mobile
GOOGLE_WEB_CLIENT_ID=

GEMINI_API_KEY=
# See https://ai.google.dev/gemini-api/docs/models for current IDs (needs image input + structured output)
GEMINI_MODEL=gemini-3.6-flash
# MINIMAL (default) or LOW; gemini-3.8-flash does not support MINIMAL
# GEMINI_THINKING_LEVEL=MINIMAL

# --- Later stages ---
# REDIS_URL=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
